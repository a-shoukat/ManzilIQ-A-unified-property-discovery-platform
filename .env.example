# ManzilIQ — copy to .env / .env.local. Never commit real secrets.
# Client (Vite) — public only
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# Alias also accepted by the client:
# VITE_SUPABASE_ANON_KEY=

# Optional Maps JS / Embed key (browser-safe restricted key)
VITE_GOOGLE_MAPS_API_KEY=

# Optional remote AI estimate URL (Flask/XGBoost etc.)
VITE_AI_ESTIMATE_URL=
# Server-only AI overrides
AI_ESTIMATE_URL=
AI_ESTIMATE_API_KEY=

# Server — OTP / notifications (Resend + Twilio)
OTP_SECRET=
RESEND_API_KEY=
OTP_FROM_EMAIL=ManzilIQ <onboarding@resend.dev>
NOTIFY_EMAIL_API_KEY=
NOTIFY_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
NOTIFY_SMS_API_KEY=

# FCM push (legacy server key)
FCM_SERVER_KEY=
# Or JSON service account for future Admin SDK path:
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Supabase service role (server / cron only — NEVER Vite-prefixed)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Installment reminder cron (required to authorize runInstallmentReminders)
# Schedule daily via external cron — see docs/OPS_RUNBOOK.md
REMINDER_CRON_SECRET=

# JazzCash (sandbox → live)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_API_URL=

# EasyPaisa
EASYPAISA_STORE_ID=
EASYPAISA_PASSWORD=
EASYPAISA_API_URL=
EASYPAISA_MERCHANT_EMAIL=
